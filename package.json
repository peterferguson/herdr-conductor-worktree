{
  "name": "herdr-conductor-worktree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Herdr plugin for creating Conductor-shaped Git worktrees.",
  "bin": {
    "herdr-conductor-worktree": "dist/index.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --target=node --format=esm --outfile=dist/index.js && chmod +x dist/index.js",
    "test": "npm run build && node --test",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5"
  },
  "engines": {
    "node": ">=18"
  }
}
